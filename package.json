{
  "name": "personal-management",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "build": "npm run build:frontend",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "lint:frontend": "npm --prefix frontend run lint",
    "dev:backend": "cd backend && mvnw.cmd spring-boot:run",
    "test:backend": "cd backend && mvnw.cmd test",
    "gitnexus:analyze": "gitnexus analyze --skills",
    "gitnexus:force": "gitnexus analyze --force --skills",
    "gitnexus:status": "gitnexus status",
    "gitnexus:serve": "gitnexus serve"
  }
}
